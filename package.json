{
  "name": "nutrilens",
  "version": "1.0.0",
  "private": true,
  "description": "AI food nutrition breakdown — attach a photo or describe a meal, get calories, macros, micros and a health score.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "desktop": "electron .",
    "build:desktop": "electron-builder --win --x64",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "keywords": [
    "nutrition",
    "ai",
    "vision",
    "calories",
    "macros"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "^6.2.5"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "com.nutrilens.desktop",
    "productName": "NutriLens",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "server.mjs",
      "server/**",
      "index.html",
      "src/**",
      "public/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "server/**",
      "node_modules/pdfjs-dist/**",
      "node_modules/mammoth/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "createStartMenuShortcut": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "perMachine": false,
      "artifactName": "NutriLens-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NutriLens-Portable-${version}.${ext}"
    }
  }
}
